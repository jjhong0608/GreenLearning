{
  "dataset": {
    "geometry_mode": "complex",
    "geometry_path": "data/geometry/pentagram_r05_h00078125.npz",
    "samples_per_line": 25,
    "validation_samples_per_line": 5,
    "sampler_mode": "forward",
    "validation_sampler_mode": "forward",
    "scale_length": 0.15,
    "validation_scale_length": 0.15,
    "deterministic": true,
    "use_operator_learning": true,
    "dtype": "float64",
    "coefficient_functions_path": "coefficients/CDR_pentagram.py"
  },
  "terminal": {
    "width": 250
  },
  "model": {
    "input_dim": 2,
    "hidden_dim": 128,
    "depth": 4,
    "activation": "rational",
    "use_bias": true,
    "dropout": 0.0,
    "use_green": true,
    "branch_input_dim": 129,
    "use_fourier": true,
    "fourier_dim": 64,
    "dtype": "float64"
  },
  "training": {
    "learning_rate": 0.005,
    "weight_decay": 0.0,
    "epochs": 200,
    "batch_size": 20000,
    "log_interval": 1,
    "compute_validation_rel_sol": true,
    "device": "cuda:1",
    "use_lr_schedule": true,
    "warmup_epochs": 20,
    "min_lr": 1e-5,
    "optimizer": {
      "name": "soap",
      "betas": [
        0.90,
        0.95
      ],
      "eps": 1e-8,
      "profile_step_time": true,
      "soap": {
        "shampoo_beta": 0.95,
        "precondition_frequency": 5,
        "max_precondition_dim": 1024,
        "merge_dims": false,
        "precondition_1d": true,
        "normalize_grads": false,
        "correct_bias": true
      }
    },
    "lbfgs_max_iter": 100,
    "lbfgs_history_size": 100,
    "lbfgs_lr": 1.0,
    "lbfgs_tolerance_grad": 1e-20,
    "lbfgs_epochs": 100,
    "integration_rule": "trapezoid",
    "green_quadrature": {
      "enabled": true,
      "rule": "split_gauss_legendre",
      "order": 16,
      "source_sampling_factor": 4,
      "source_interpolation": "cubic"
    },
    "compile": {
      "enabled": true
    }
  },
  "pipeline": {
    "run_green": true,
    "run_coupling": false,
    "green_pretrained_path": null,
    "coupling_pretrained_path": null
  }
}
