{
  "dataset": {
    "geometry_mode": "complex",
    "geometry_path": "data/geometry/annulus_02_05_1_128.npz",
    "test_path": "data/complex_samples/annulus_02_05_1_128_poisson/test",
    "coefficient_functions_path": "coefficients/Pure_Poisson.py",
    "coupling_source": {
      "mode": "indexed_gp",
      "indexed_gp": {
        "num_train": 4800,
        "num_valid": 300,
        "seed": 0,
        "lengthscale": 0.15,
        "amplitude": 1.0,
        "mean": 0.0
      }
    },
    "reference_diagnostics": {
      "training": false,
      "validation": false
    },
    "dtype": "float64"
  },
  "terminal": {
    "width": 350
  },
  "coupling_model": {
    "branch_input_dim": 129,
    "hidden_dim": 256,
    "depth": 4,
    "activation": "rational",
    "use_bias": true,
    "dropout": 0.0,
    "dtype": "float64",
    "coefficient_terms": {
      "diffusion": false,
      "convection": false,
      "reaction": false
    },
    "balance_projection": {
      "enabled": true,
      "mode": "physical_symmetric"
    },
    "pre_projection_fusion": {
      "enabled": true,
      "mode": "residual_correction",
      "combination": "convex_average",
      "nonlinear_hidden_dim": 16,
      "nonlinear_depth": 1,
      "nonlinear_final_init_scale": 0.0,
      "gate_initial_value": 0.05,
      "eps": 1e-12
    },
    "branch_fusion": {
      "mode": "product_fuser"
    },
    "axis_1d_trunk": {
      "enabled": true,
      "num_frequencies": 4,
      "max_frequency": 8.0,
      "transverse_trunk": {
        "enabled": true,
        "fusion": "product_fuser",
        "length_context": true
      }
    }
  },
  "coupling_training": {
    "learning_rate": 0.002,
    "epochs": 100,
    "batch_size": 300,
    "weight_decay": 0.05,
    "log_interval": 1,
    "device": "cuda:1",
    "gradient_clip_max_norm": 1.0,
    "use_lr_schedule": true,
    "warmup_epochs": 10,
    "min_lr": 1e-5,
    "optimizer": {
      "name": "soap",
      "betas": [
        0.95,
        0.99
      ],
      "eps": 1e-8,
      "profile_step_time": true,
      "soap": {
        "shampoo_beta": 0.95,
        "precondition_frequency": 3,
        "max_precondition_dim": 1024,
        "merge_dims": false,
        "precondition_1d": true,
        "normalize_grads": false,
        "correct_bias": true
      }
    },
    "periodic_checkpoint": {
      "enabled": true,
      "every_epochs": 50
    },
    "compile": {
      "enabled": true
    },
    "best_energy_checkpoint": {
      "enabled": true
    }
  },
  "pipeline": {
    "run_green": false,
    "run_coupling": true,
    "green_pretrained_path": "checkpoints/Annulus_poisson/green/model.safetensors"
  }
}
